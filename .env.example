# Configure these in Vercel Project Settings -> Environment Variables.
# Each CTA action checks the country-specific value first, then the DEFAULT value.
# Replace every example URL with a real destination from your application.

REDIRECT_JOIN_US=https://app.example.com/signup
REDIRECT_JOIN_DEFAULT=https://app.example.com/signup

REDIRECT_BROWSE_US=https://app.example.com/discover
REDIRECT_BROWSE_DEFAULT=https://app.example.com/discover

REDIRECT_CHAT_US=https://app.example.com/chat
REDIRECT_CHAT_DEFAULT=https://app.example.com/chat

REDIRECT_CALL_US=https://app.example.com/call
REDIRECT_CALL_DEFAULT=https://app.example.com/call

REDIRECT_PRICING_US=https://app.example.com/pricing
REDIRECT_PRICING_DEFAULT=https://app.example.com/pricing

REDIRECT_CONTACT_US=https://app.example.com/contact
REDIRECT_CONTACT_DEFAULT=https://app.example.com/contact

# Optional shared fallback if an action-specific destination is not set:
# REDIRECT_US_URL=https://app.example.com
# REDIRECT_DEFAULT_URL=https://app.example.com
